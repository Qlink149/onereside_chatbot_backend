# Core
OPENAI_API_KEY=
MONGO_URI=
# Production application database (default OneReside). Do not point pytest here.
MONGO_PROD_DB_NAME=OneReside
# Optional override for the running app DB (e2e / local only — use OneReside_test).
# MONGO_DB_NAME=OneReside_test
# Required for pytest — characterisation/identity refuse to run if unset or equal to prod.
MONGO_TEST_DB_NAME=OneReside_test
ENV_MODE="dev"

# Gupshup (WhatsApp Business API)
GUPSHUP_APP_ID=
GUPSHUP_TOKEN=
GUPSHUP_APP_NAME=
GUPSHUP_API_KEY=

# Chroma Cloud (vector search)
CHROMA_API_KEY=
CHROMA_TENANT=

# Pinecone (legacy, not currently used by any pipeline)
PINECONE_API=
PINECONE_NAMESPACE=

# Cloudflare R2 (object storage)
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_ENDPOINT=
R2_BUCKET=
R2_PUBLIC_URL=

# Razorpay (payments)
RAZORPAY_APP_ID=
RAZORPAY_APP_SECRETE=
RAZORPAY_WEBHOOK_SECRET=

# Admin dashboard auth
LOGIN_USERNAME=
LOGIN_PASS=
JWT_SECRET=
JWT_EXPIRE_MINUTES=480
DASHBOARD_API_KEY=

# Legacy / not currently wired into any processor or route
WEBHOOK_API=
GOOGLE_PRIVATE_KEY_ID=
QLINK_APP_ID=
QLINK_APP_NAME=
QLINK_TOKEN=
FUTWORKS_API=
FUTWORK_PACIFIC_AGENT=

# Web channel (widget on brand sites / Shopify)
# Production default when unset: https://onereside.com only. Put localhost origins in local .env only.
WEB_ALLOWED_ORIGINS=
WEB_SUCCESS_URL=https://onereside.com
WEB_KILL_SWITCH=
